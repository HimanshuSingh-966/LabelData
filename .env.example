# ==============================================================================
# 1. LOCAL DATASET & STAGING PATHS (Stage 1: Local PC Pull & Deduplication)
# ==============================================================================
# Directory where the complete raw master dataset is placed on your local PC
LOCAL_RAW_DATASET_DIR=./data/raw

# Directory where the sampled/pulled batch of images is saved locally
LOCAL_PULLED_BATCH_DIR=./data/pulled_batch

# Local CSV history tracking all photos ever pulled/uploaded from this PC
# (Guarantees no duplicate images are ever pulled or uploaded across batches)
LOCAL_PULL_HISTORY_PATH=./data/pulled_history.csv

# ==============================================================================
# 2. DATASET SAMPLING & SHUFFLING CONFIGURATION
# ==============================================================================
# 1. Pull pool: 3,000 raw images
# 2. Filter & sample target: ~2,000–2,400 images (within 1,500–2,500 labeling target)
# 3. Seed: Fixed for deterministic, reproducible random ordering
PULL_LIMIT=3000
TARGET_SAMPLE_SIZE=2200
SHUFFLE_SEED=42

# ==============================================================================
# 3. FACE-PARSING & MOUTH CROP CONFIGURATION (EasyPortrait SegFormer-B0)
# ==============================================================================
# Local path for ONNX model weights (auto-downloaded from HuggingFace if not present)
MODEL_PATH=./models/segformer_b0_fp_512.onnx

# CSV log recording each image crop status (success/failed, bounding box)
CROP_LOG_PATH=./data/crop_log.csv

# Minimum teeth/lips pixel count to classify photo as a valid smile (discards blurry/no-teeth)
CROP_MIN_PIXELS=50

# Padding ratio around mouth bounding box (15% on each side)
CROP_PADDING=0.15

# ==============================================================================
# 4. BACKBLAZE B2 STORAGE & CLOUD PATHS (Stage 2: Active Labeling)
# ==============================================================================
# Backblaze B2 Application Key credentials and bucket name
B2_KEY_ID=your_b2_application_key_id
B2_APP_KEY=your_b2_application_key
B2_BUCKET_NAME=your_b2_bucket_name

# Name/key for the batch review manifest inside B2 bucket
B2_IMAGE_LIST_PATH=image_list.json

# Name/key for the progress CSV inside B2 bucket (maintained by FastAPI backend)
B2_LABELS_CSV_PATH=labels.csv

# Optional subfolder prefix inside the B2 bucket (leave empty for bucket root)
B2_IMAGES_PREFIX=

# Seconds an image is reserved for a labeler before it goes back to the pool (default: 300 = 5 min)
RESERVATION_TIMEOUT_SECONDS=300

# ==============================================================================
# 4. NETWORK & DEPLOYMENT URLS
# ==============================================================================
# Allowed Frontend origin for CORS in backend (e.g., https://your-app.vercel.app or http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Base URL pointing to deployed FastAPI backend (e.g., https://your-backend.onrender.com or http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
